diff --git a/frontend/src/components/historia/CintaDecadas.jsx b/frontend/src/components/historia/CintaDecadas.jsx
new file mode 100644
index 0000000..497b3a4
--- /dev/null
+++ b/frontend/src/components/historia/CintaDecadas.jsx
@@ -0,0 +1,42 @@
+import { Link } from "react-router-dom";
+import { useTranslation } from "react-i18next";
+import { agruparPorDecada } from "../../data/historiaCine";
+
+/**
+ * Cinta de décadas: cada ficha enlaza al catálogo filtrado por década.
+ * Muestra solo las décadas que tienen películas registradas.
+ */
+function CintaDecadas({ peliculas = [], activa = null, mostrarTodas = false, className = "" }) {
+  const { t } = useTranslation();
+  const grupos = agruparPorDecada(peliculas);
+
+  if (grupos.length === 0) return null;
+
+  return (
+    <nav className={`decade-rail ${className}`.trim()} aria-label={t("movies.decadeFilter")}>
+      {mostrarTodas && (
+        <Link
+          to="/peliculas"
+          className={`decade-chip decade-chip-all${activa ? "" : " is-active"}`}
+          aria-current={activa ? undefined : "true"}
+        >
+          <span className="decade-chip-year">{t("movies.allDecades")}</span>
+          <small>{t("history.films", { count: peliculas.length })}</small>
+        </Link>
+      )}
+      {grupos.map(({ decada, items }) => (
+        <Link
+          key={decada}
+          to={`/peliculas?decada=${decada}`}
+          className={`decade-chip${activa === decada ? " is-active" : ""}`}
+          aria-current={activa === decada ? "true" : undefined}
+        >
+          <span className="decade-chip-year">{decada}s</span>
+          <small>{t("history.films", { count: items.length })}</small>
+        </Link>
+      ))}
+    </nav>
+  );
+}
+
+export default CintaDecadas;
diff --git a/frontend/src/components/historia/LineaTiempoMini.jsx b/frontend/src/components/historia/LineaTiempoMini.jsx
new file mode 100644
index 0000000..95cb192
--- /dev/null
+++ b/frontend/src/components/historia/LineaTiempoMini.jsx
@@ -0,0 +1,37 @@
+import { Link } from "react-router-dom";
+import { useTranslation } from "react-i18next";
+import { HITOS } from "../../data/historiaCine";
+
+// Seis paradas que resumen la historia; el detalle completo vive en /historia.
+const PARADAS = ["1922", "1963", "1995", "2003", "2010", "2025"];
+
+function LineaTiempoMini() {
+  const { t, i18n } = useTranslation();
+  const idioma = i18n.language?.startsWith("en") ? "en" : "es";
+  const paradas = PARADAS.map((id) => HITOS.find((h) => h.id === id)).filter(Boolean);
+
+  return (
+    <section className="mini-timeline-section" aria-labelledby="mini-timeline-title">
+      <div className="mini-timeline-heading">
+        <div>
+          <span className="public-eyebrow">{t("home.timelineEyebrow")}</span>
+          <h2 id="mini-timeline-title">{t("home.timelineTitle")}</h2>
+        </div>
+        <Link to="/historia" className="mini-timeline-cta">{t("home.timelineCta")}</Link>
+      </div>
+
+      <ol className="mini-timeline">
+        {paradas.map((hito) => (
+          <li key={hito.id}>
+            <Link to={`/historia#h-${hito.id}`}>
+              <span className="mini-timeline-year">{hito.etiquetaAnio || hito.anio}</span>
+              <strong>{hito[idioma].titulo}</strong>
+            </Link>
+          </li>
+        ))}
+      </ol>
+    </section>
+  );
+}
+
+export default LineaTiempoMini;
diff --git a/frontend/src/components/historia/historia.components.test.jsx b/frontend/src/components/historia/historia.components.test.jsx
new file mode 100644
index 0000000..50757bf
--- /dev/null
+++ b/frontend/src/components/historia/historia.components.test.jsx
@@ -0,0 +1,54 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { cleanup, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({
+    t: (clave, opciones = {}) => (opciones.count !== undefined ? `${clave}:${opciones.count}` : clave),
+    i18n: { language: "es" },
+  }),
+}));
+
+import CintaDecadas from "./CintaDecadas";
+import LineaTiempoMini from "./LineaTiempoMini";
+
+const envolver = (nodo) => render(<MemoryRouter>{nodo}</MemoryRouter>);
+
+describe("CintaDecadas", () => {
+  afterEach(cleanup);
+
+  const peliculas = [
+    { Id: 1, FechaEstreno: "1995-01-01" },
+    { Id: 2, FechaEstreno: "2007-01-01" },
+    { Id: 3, FechaEstreno: "2008-01-01" },
+  ];
+
+  it("enlaza cada década al catálogo filtrado y cuenta sus películas", () => {
+    envolver(<CintaDecadas peliculas={peliculas} />);
+    const enlace2000 = screen.getByText("2000s").closest("a");
+    expect(enlace2000.getAttribute("href")).toBe("/peliculas?decada=2000");
+    expect(enlace2000.textContent).toContain("history.films:2");
+  });
+
+  it("marca la década activa y muestra «todas» cuando se pide", () => {
+    envolver(<CintaDecadas peliculas={peliculas} activa={1990} mostrarTodas />);
+    expect(screen.getByText("1990s").closest("a").getAttribute("aria-current")).toBe("true");
+    expect(screen.getByText("movies.allDecades").closest("a").getAttribute("aria-current")).toBeNull();
+  });
+
+  it("no renderiza nada si no hay películas con fecha", () => {
+    const { container } = envolver(<CintaDecadas peliculas={[{ Id: 9, FechaEstreno: null }]} />);
+    expect(container.querySelector(".decade-rail")).toBeNull();
+  });
+});
+
+describe("LineaTiempoMini", () => {
+  afterEach(cleanup);
+
+  it("muestra seis paradas que enlazan a su hito en /historia", () => {
+    envolver(<LineaTiempoMini />);
+    const enlaces = screen.getAllByRole("link").filter((a) => a.getAttribute("href")?.startsWith("/historia#h-"));
+    expect(enlaces).toHaveLength(6);
+    expect(enlaces[0].getAttribute("href")).toBe("/historia#h-1922");
+  });
+});
